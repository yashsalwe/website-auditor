# The ID of the target Google Spreadsheet (from its URL)
GOOGLE_SHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
